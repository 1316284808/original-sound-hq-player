<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    mc:Ignorable="d">

    <Grid>
        <Grid RowDefinitions="*,Auto">
            <Grid Grid.Row="0" Margin="0,45,0,0">
                <NavigationView
                    x:Name="NavigationViewControl"
                    BackRequested="NavigationViewControl_BackRequested"
                    IsBackButtonVisible="Collapsed"
                    
                    IsBackEnabled="{x:Bind ViewModel.AppViewModel.IsBackBtnEnable, Mode=OneWay}"
                    IsPaneToggleButtonVisible="True"
                    ItemInvoked="NavigationView_ItemInvoked"
                    SelectionChanged="NavigationViewControl_SelectionChanged"
                    CompactPaneLength="48"
                    OpenPaneLength="216"
                    PaneDisplayMode="Auto">
                    <NavigationView.PaneToggleButtonStyle>
                        <!--  自包含样式：WinUI 未提供可引用的基样式键（源码里是内部的 PaneToggleButtonStyle，
                              写 BasedOn 会在加载时抛 XamlParseException），故尺寸/配色/圆角等全部显式给出  -->
                        <Style TargetType="Button">
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemForeground}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid x:Name="LayoutRoot"
                              Background="{TemplateBinding Background}"
                              Padding="{TemplateBinding Padding}">
                                            <!--  字形随侧边栏开合在 InHome / BackHome 间切换；模板内无法用 x:Bind，
                                                  走继承的 DataContext（页面 → ViewModel）的传统 Binding  -->
                                            <FontIcon
                                x:Name="NavToggleGlyphIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="16"
                                Glyph="{Binding ViewModel.NavButtonGlyph}" />

                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Target="LayoutRoot.Background"
                                                    Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Pressed">
                                                        <VisualState.Setters>
                                                            <Setter Target="LayoutRoot.Background"
                                                    Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                    <VisualState x:Name="Disabled">
                                                        <VisualState.Setters>
                                                            <Setter Target="LayoutRoot.Opacity"
                                                    Value="{ThemeResource ControlDisabledOpacity}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </NavigationView.PaneToggleButtonStyle>
                    <NavigationView.MenuItems >
                        <NavigationViewItem Tag="AllSongs">
                            <NavigationViewItem.Icon>
                                <FontIcon helper:IconGlyph.IconKind="AllSongsOutline" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="AllSongs" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                      
                        <NavigationViewItem Tag="ArtistList">
                            <NavigationViewItem.Icon>
                                <FontIcon helper:IconGlyph.IconKind="ArtistOutline" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="ArtistList" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="AlbumList">
                            <NavigationViewItem.Icon>
                                <FontIcon helper:IconGlyph.IconKind="AlbumOutline" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="AlbumList" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="MusicLibrary">
                            <NavigationViewItem.Icon>
                                <FontIcon helper:IconGlyph.IconKind="LibraryOutline" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="MusicLibrary" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                        <NavigationViewItem Tag="Stats">
                            <NavigationViewItem.Icon>
                                <FontIcon helper:IconGlyph.IconKind="Stats" />
                            </NavigationViewItem.Icon>
                            <NavigationViewItem.Content>
                                <TextBlock x:Uid="Stats" />
                            </NavigationViewItem.Content>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                    <Frame x:Name="MainFrame" Background="Transparent" />
                </NavigationView>
            </Grid>
                <Grid
                    x:Name="BottomControlBar"
                    Grid.Row="1"
                    MinHeight="96"
                    Margin="0"
                    RowDefinitions="Auto,*"
                    Visibility="{x:Bind NavigationViewControl.Visibility, Mode=OneWay}">
                    <!-- 贯穿式进度条：独占顶部整行，横向铺满 -->
                    <Slider
                        x:Name="ProgressSlider"
                        Grid.Row="0"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Loaded="ProgressSlider_Loaded"
                        Maximum="{x:Bind ViewModel.AppViewModel.ProgressSliderMax, Mode=TwoWay}"
                        Minimum="0"
                        PointerEntered="ProgressSlider_PointerEntered"
                        PointerExited="ProgressSlider_PointerExited"
                        Style="{StaticResource PlaybackSliderStyle}"
                        ThumbToolTipValueConverter="{StaticResource AdvancedThumbToolTipValueConverter}"
                        Value="{x:Bind ViewModel.AppViewModel.ProgressSlider, Mode=TwoWay}" />

                    <Grid
                        Grid.Row="1"
                        Margin="0"
                        ColumnDefinitions="*,Auto,*">
                    <Grid
                        x:Name="AlbumCoverAuthorTitleModel"
                        Grid.Column="0"
                        Margin="0"
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,*">
                        <Button
                            x:Name="AlbumCoverImageBtn"
                            Grid.Column="0"
                            Margin="5,0,5,0"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.AlbumCoverImageCommand, Mode=OneWay}"
                            CornerRadius="30"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource SimpleHoverButtonStyle}">
                            <Grid RowDefinitions="auto">
                                <Border
                                    Grid.Row="0"
                                    Width="60"
                                    Height="60"
                                    CornerRadius="30">
                                    <Grid
                                        x:Name="AlbumCoverImageGrid"
                                        Width="60"
                                        Height="60"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <RotateTransform x:Name="AlbumCoverRotateTransform" />
                                        </Grid.RenderTransform>
                                    <Grid x:Name="AlbumCoverImage" Canvas.ZIndex="1">
                                        <Image
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Stretch="UniformToFill">
                                            <interactivity:Interaction.Behaviors>
                                                <behaviors:FadeImageBehavior
                                                    ImageHash="{x:Bind ViewModel.AppViewModel.LyricPageBackgroundHash, Mode=OneWay}"
                                                    IsDark="{x:Bind ViewModel.AppViewModel.IsDarkMode, Mode=OneWay}"
                                                    Duration="00:00:1" />
                                            </interactivity:Interaction.Behaviors>
                                        </Image>
                                    </Grid>
                                    <Grid Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}" Canvas.ZIndex="0">
                                        <FontIcon
                                            Canvas.ZIndex="0"
                                            FontSize="30"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            helper:IconGlyph.IconKind="Music" />
                                    </Grid>
                                </Grid>
                                </Border>

                                <FontIcon
                                    x:Name="AlbumCoverImageChevronUp"
                                    Grid.Row="0"
                                    helper:IconGlyph.IconKind="GlyphE70E"
                                    Opacity="0" />
                            </Grid>
                        </Button>
                        <Grid 
                            Grid.Column="1"
                            MaxWidth="240"
                            Margin="6,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            RowDefinitions="Auto,Auto,Auto"
                            Visibility="{x:Bind tools:BindUtils.GetMusicVisibility(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                            <dev:AutoScrollView
                                Grid.Row="0"
                                IsPlaying="False"
                                PointerCanceled="AutoScrollHover_PointerCanceled"
                                PointerEntered="AutoScrollHover_PointerEntered"
                                PointerExited="AutoScrollHover_PointerExited">
                                <TextBlock
                                    x:Name="MusicTitleTextBlock"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </dev:AutoScrollView>
                            <Button
                                x:Name="MusicAlbumButton"
                                Grid.Row="1"  MinHeight="0" Height="auto"
                              VerticalAlignment="Center" CornerRadius="2"
                                Background="Transparent"
                                 Margin="0,1" Padding="0" HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.MusicBrowseVM.AlbumButtonCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                                <Button.Content>
                                    <dev:AutoScrollView
                                        IsPlaying="False"
                                        PointerCanceled="AutoScrollHover_PointerCanceled"
                                        PointerEntered="AutoScrollHover_PointerEntered"
                                        PointerExited="AutoScrollHover_PointerExited">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Album, Mode=OneWay}"
                                            TextTrimming="WordEllipsis" />
                                    </dev:AutoScrollView>
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="MusicAuthorButton"
                                Grid.Row="2" CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Margin="0,1" Padding="1,0" MinHeight="0" Height="auto"
                                HorizontalContentAlignment="Left"
                                Command="{x:Bind ViewModel.MusicBrowseVM.ArtistButtonCommand, Mode=OneWay}"
                                CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}">
                                <Button.Content>
                                    <dev:AutoScrollView
                                        IsPlaying="False"
                                        PointerCanceled="AutoScrollHover_PointerCanceled"
                                        PointerEntered="AutoScrollHover_PointerEntered"
                                        PointerExited="AutoScrollHover_PointerExited">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.Author, Mode=OneWay}"
                                            TextTrimming="WordEllipsis" />
                                    </dev:AutoScrollView>
                                </Button.Content>
                            </Button>
                          
                        </Grid>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        RowDefinitions="Auto">

                        <Button
                            x:Name="PlayBarFavouriteButton"
                            Grid.Column="0"
                            Margin="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic.UpdateFavouriteCommand, Mode=OneWay}"
                            CommandParameter="{x:Bind ViewModel.AppViewModel.CurrentPlayingMusic, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsCurrentMusicExist(ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                FontSize="18"
                                Foreground="Red"
                                Glyph="{x:Bind tools:BindUtils.FavouriteGlyphConverter(ViewModel.AppViewModel.CurrentPlayingMusic.IsFavorite), Mode=OneWay}" />
                        </Button>

                        <!-- 进度数显：紧跟收藏按钮之后（与播放详情页 ControlsStack 一致） -->
                        <StackPanel
                            Grid.Column="1"
                            Margin="6,0,6,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{x:Bind ViewModel.AppViewModel.ElapsedTimeText, Mode=OneWay}" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Opacity="0.6"
                                Text="/" />
                            <TextBlock
                                x:Name="PlayTimeTextBlock"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Text="{x:Bind ViewModel.AppViewModel.RemainingTimeText, Mode=OneWay}" />
                        </StackPanel>

                        <Button
                            x:Name="LastMusicButton"
                            Grid.Column="2"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.Playback.PreviousCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsSwitchEntryEnabled(ViewModel.AppViewModel.IsPlaybackEngineReady, ViewModel.AppViewModel.CurrentPlayingList), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" helper:IconGlyph.IconKind="Previous" />
                        </Button>

                        <Button
                            x:Name="PlayPauseButton"
                            Grid.Column="3"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.Playback.ToggleCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsPlayButtonEnabled(ViewModel.AppViewModel.IsPlaybackEngineReady, ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource PlayButtonStyle}">
                            <FontIcon
                                Width="32"
                                Height="32"
                                FontSize="26"
                                Glyph="{x:Bind tools:BindUtils.PlayStatusToGlyphConverter(ViewModel.AppViewModel.IsPlaying), Mode=OneWay}" />
                        </Button>

                        <Button
                            x:Name="NextMusicButton"
                            Grid.Column="4"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.Playback.NextCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsSwitchEntryEnabled(ViewModel.AppViewModel.IsPlaybackEngineReady, ViewModel.AppViewModel.CurrentPlayingList), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" helper:IconGlyph.IconKind="Next" />
                        </Button>

                        <Button
                            x:Name="StopButton"
                            Grid.Column="5"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.AppViewModel.StopButtonChangedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind tools:BindUtils.IsPlayButtonEnabled(ViewModel.AppViewModel.IsPlaybackEngineReady, ViewModel.AppViewModel.CurrentPlayingMusic), Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon FontSize="18" helper:IconGlyph.IconKind="LyricsAlt" />
                        </Button>
                    </Grid>
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="DesktopLyricsButton"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="DesktopLyricsButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <TextBlock
                                x:Name="DesktopLyricsIcon"
                                x:Uid="DesktopLyricsIconLabel"
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                FontFamily="Microsoft YaHei UI"
                                FontSize="18"
                                FontWeight="Normal"
                                IsHitTestVisible="False"
                                IsTextScaleFactorEnabled="False"
                                Opacity="{x:Bind tools:BindUtils.DesktopLyricsButtonOpacity(ViewModel.DesktopLyrics.IsEnabled), Mode=OneWay}"
                                TextAlignment="Center" />
                        </Button>
                        <Button
                            x:Name="EqualizerButton"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.EqualizerButtonCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="EqualizerIcon"
                                FontSize="18"
                                helper:IconGlyph.IconKind="Equalizer" />
                        </Button>
                        <Button
                            x:Name="VolumeButton"
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            PointerWheelChanged="VolumeButton_PointerWheelChanged"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="VolumeSliderIcon"
                                Grid.Column="0"
                                Margin="0"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="{x:Bind tools:BindUtils.VolumeToGlyphConverter(ViewModel.AppViewModel.Volume), Mode=OneWay}" />
                            <Button.Flyout>
                                <Flyout x:Name="VolumeFlyout" Placement="Top">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Command="{x:Bind ViewModel.AppViewModel.VolumeSliderIconButtonChangedCommand, Mode=OneWay}">
                                            <FontIcon
                                                x:Name="VolumeInsideSliderIcon"
                                                Grid.Column="0"
                                                Margin="0"
                                                VerticalAlignment="Center"
                                                Glyph="{x:Bind tools:BindUtils.VolumeToGlyphConverter(ViewModel.AppViewModel.Volume), Mode=OneWay}" />
                                        </Button>
                                        <Slider
                                            x:Name="VolumeSlider"
                                            Grid.Column="1"
                                            Width="150"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            PointerEntered="VolumeSlider_PointerEntered"
                                            PointerExited="VolumeSlider_PointerExited"
                                            PointerWheelChanged="VolumeSlider_PointerWheelChanged"
                                            Value="{x:Bind ViewModel.AppViewModel.Volume, Mode=TwoWay}" />
                                        <TextBlock
                                            Width="30"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind ViewModel.AppViewModel.Volume, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </Button>
                        <TeachingTip
                            x:Name="CurrentPlayListTeachingTip"
                            IsLightDismissEnabled="True"
                            Target="{x:Bind CurrentPlayListButton}">
                            <TeachingTip.Content>
                                <Grid Width="290">
                                    <ListView
                                        x:Name="CurrentPlayListView"
                                        Width="290"
                                        MaxHeight="400"
                                        Margin="0,24,0,0"
                                        DoubleTapped="CurrentPlayListView_DoubleTapped"
                                        ItemsSource="{x:Bind ViewModel.AppViewModel.CurrentPlayingList, Mode=OneWay}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="model:Music">
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <Button
                                        x:Name="CloseButton"
                                        Width="24"
                                        Height="24"
                                        Margin="0,0,4,0"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Canvas.ZIndex="999"
                                        Click="CurrentPlayListTeachingTipCloseButton_Click">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            helper:IconGlyph.IconKind="GlyphE711" />
                                    </Button>
                                </Grid>
                            </TeachingTip.Content>
                        </TeachingTip>
                        <Button
                            x:Name="PlayModeButton"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Command="{x:Bind ViewModel.MusicBrowseVM.PlayModeChangedCommand, Mode=OneWay}"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="PlayModeIcon"
                                FontSize="18"
                                Glyph="{x:Bind tools:BindUtils.PlayModeToGlyphConverter(ViewModel.AppViewModel.CurrentPlayMode), Mode=OneWay}" />
                        </Button>
                        <Button
                            x:Name="CurrentPlayListButton"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Click="CurrentPlayListButton_Click"
                            Style="{StaticResource MenuButtonStyle}">
                            <FontIcon
                                x:Name="CurrentPlayListIcon"
                                FontSize="18"
                                helper:IconGlyph.IconKind="QueueList" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <Frame x:Name="PlayingFrame" Visibility="Collapsed" />
        <Grid
            x:Name="AppTitleBar"
            Height="45"
            Margin="0"
            Padding="0"
            VerticalAlignment="Top"
            Background="Transparent"
            ColumnDefinitions="Auto,*,Auto"
            PointerEntered="AppTitleBar_PointerEntered"
            PointerExited="AppTitleBar_PointerExited">
            <Grid.OpacityTransition>
                <ScalarTransition />
            </Grid.OpacityTransition>
            <StackPanel
                Grid.Column="0"
                Margin="0,0,0,0"
                Opacity="{x:Bind tools:BindUtils.VisibilityToOpacityConverter(NavigationViewControl.Visibility), Mode=OneWay}"
                Orientation="Horizontal">
                <Button
                    x:Name="BackButton"
                    Click="BackButton_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8,4"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="返回上一页">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="16"
                            helper:IconGlyph.IconKind="Back" />
                        <TextBlock
                            x:Uid="AppTitle"
                            VerticalAlignment="Center"
                            FontSize="12"
                            IsHitTestVisible="False"
                            IsTextScaleFactorEnabled="False"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Button>
                <!--
                    全局唯一任务指示器：环 + 百分比 + 操作文本横排。单操作显示独立百分比；
                    多操作横排并列、各带百分比（不做跨操作加权平均，会倒退）。
                -->
                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.Progress.IsActive), Mode=OneWay}">
                    <ProgressRing
                        Width="16"
                        Height="16"
                        MinWidth="16"
                        MinHeight="16"
                        IsActive="{x:Bind ViewModel.AppViewModel.Progress.IsActive, Mode=OneWay}"
                        IsIndeterminate="{x:Bind ViewModel.AppViewModel.Progress.IsIndeterminate, Mode=OneWay}"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.AppViewModel.Progress.Percent, Mode=OneWay}" />
                    <!--  百分比仅单操作确定进度时显示；多操作的百分比在文本内  -->
                    <TextBlock
                        MinWidth="34"
                        VerticalAlignment="Center"
                        IsTextScaleFactorEnabled="False"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.AppViewModel.Progress.PercentText, Mode=OneWay}"
                        Visibility="{x:Bind tools:BindUtils.BoolToVisibilityConverter(ViewModel.AppViewModel.Progress.IsPercentVisible), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        IsTextScaleFactorEnabled="False"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.AppViewModel.Progress.DisplayText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <Button
                x:Name="CancelPlayingDetailButton"
                Grid.Column="0"
                Margin="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Click="CancelPlayingDetailButton_Click"
                Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsPointerOverTitleBar), Mode=OneWay}"
                Style="{StaticResource TitleBarButtonStyle}"
                Visibility="{x:Bind ViewModel.AppViewModel.IsPlayingDetailVisible, Mode=OneWay}">
                <Button.OpacityTransition>
                    <ScalarTransition />
                </Button.OpacityTransition>
                <FontIcon FontSize="18" helper:IconGlyph.IconKind="GlyphE70D" />
            </Button>
            <StackPanel
                x:Name="TopRightButtons"
                Grid.Column="2"
                Margin="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsPointerOverTitleBar), Mode=OneWay}"
                Orientation="Horizontal">
                <StackPanel.OpacityTransition>
                    <ScalarTransition />
                </StackPanel.OpacityTransition>
                <!--  主题切换：图标显示点击后进入的模式（暗色时显示亮色图标，反之显示暗色图标）  -->
                <Button
                    x:Name="ThemeToggleTitleBarButton"
                    AutomationProperties.Name="{x:Bind tools:BindUtils.ThemeToggleTextConverter(ViewModel.AppViewModel.IsDarkMode), Mode=OneWay}"
                    Command="{x:Bind ViewModel.AppViewModel.ToggleThemeCommand, Mode=OneWay}"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind tools:BindUtils.ThemeToggleTextConverter(ViewModel.AppViewModel.IsDarkMode), Mode=OneWay}">
                    <Grid>
                        <FontIcon
                            FontSize="14"
                            helper:IconGlyph.IconKind="LightMode"
                            Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsDarkMode), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                        </FontIcon>
                        <FontIcon
                            FontSize="14"
                            helper:IconGlyph.IconKind="DarkMode"
                            Opacity="{x:Bind tools:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsDarkMode), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                        </FontIcon>
                    </Grid>
                </Button>
                <Button
                    
                    x:Name="FullscreenTitleBarButton"
                    x:Uid="FullscreenTitleBarButton"
                    Click="FullscreenTitleBarButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="{x:Bind tools:BindUtils.FullScreenGlyphConverter(ViewModel.AppViewModel.IsFullScreen), Mode=OneWay}" />
                </Button>
                <Button
                    
                    x:Name="MinimizeButton"
                    x:Uid="MinimizeButton"
                    Click="MinimizeButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsFullScreen), Mode=OneWay}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        helper:IconGlyph.IconKind="Minimize" />
                </Button>
                <Button
                    
                    x:Name="MaximizeButton"
                    x:Uid="MaximizeButton"
                    Click="MaximizeButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Visibility="{x:Bind tools:BindUtils.BoolToVisibilityReConverter(ViewModel.AppViewModel.IsFullScreen), Mode=OneWay}">
                    <Grid>
                        <FontIcon
                            x:Name="EnterMaximizeFontIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            helper:IconGlyph.IconKind="GlyphE71A"
                            Opacity="{x:Bind tools:BindUtils.BoolToOpacityReConverter(ViewModel.AppViewModel.IsMaximized), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                        </FontIcon>
                        <FontIcon
                            x:Name="ExitMaximizeFontIcon"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="14"
                            helper:IconGlyph.IconKind="FullScreenAlt"
                            Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.AppViewModel.IsMaximized), Mode=OneWay}">
                            <FontIcon.OpacityTransition>
                                <ScalarTransition />
                            </FontIcon.OpacityTransition>
                        </FontIcon>
                    </Grid>
                </Button>
                <Button
                    
                    x:Name="CloseTitleBarButton"
                    x:Uid="CloseTitleBarButton"
                    Click="CloseTitleBarButton_Click"
                    Style="{StaticResource TitleBarCloseButtonStyle}">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        helper:IconGlyph.IconKind="GlyphE711" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
