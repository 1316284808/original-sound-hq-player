<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.SongListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:extensions="using:WinUIMusicPlayer.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    IsTabStop="True"
    TabIndex="0"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  歌曲行容器与其它歌曲列表共用 App.xaml 的 MusicRowListViewItemStyle：
              行高、圆角、选中/悬浮底色统一走系统画刷，这里只保留列表右侧留白与右键菜单。  -->
        <Style
            x:Key="ListViewItemStyle"
            BasedOn="{StaticResource MusicRowListViewItemStyle}"
            TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,15,0" />
            <!--  右键菜单：菜单项由 MenuFlyoutExtensions 在 Opening 时按 ViewModel.MenuOptions 重建
                  （先执行 PrepareMenuCommand 刷新可用态与「添加到播放列表」子项），所以必须挂在容器上  -->
            <Setter Property="ContextFlyout">
                <Setter.Value>
                    <MenuFlyout extensions:MenuFlyoutExtensions.PrepareCommand="{x:Bind ViewModel.PrepareMenuCommand}" extensions:MenuFlyoutExtensions.ItemsSource="{x:Bind ViewModel.MenuOptions, Mode=OneWay}" />
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid>
        <ListView
            x:Name="MusicListView"
            DoubleTapped="MusicListView_DoubleTapped"
            ItemContainerStyle="{StaticResource ListViewItemStyle}"
            ItemsSource="{x:Bind ViewModel.AppViewModel.ListSongs, Mode=OneWay}"
            RightTapped="MusicListView_RightTapped"
            SelectedItem="{x:Bind ViewModel.SelectedMusic, Mode=TwoWay}"
            SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Music">
                    <controls:MusicListRowControl
                        AlbumInvoked="MusicRow_AlbumInvoked"
                        ArtistInvoked="MusicRow_ArtistInvoked"
                        Music="{x:Bind Mode=OneWay}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
