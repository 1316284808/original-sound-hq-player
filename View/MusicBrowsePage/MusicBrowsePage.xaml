<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.MusicBrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:customControls="using:WinUIMusicPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dev="using:DevWinUI"
    xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    IsTabStop="True"
    TabIndex="0"
    mc:Ignorable="d">
    <Page.Resources>
        <!--  全部播放 / 随机播放：默认无边框无强调色，仅在获得焦点时显现边框与强调色，两按钮风格统一  -->
        <Style x:Key="SubtlePlayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                AutomationProperties.AccessibilityView="Raw"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ButtonBorder"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="0" RowDefinitions="Auto,Auto,*">
        <Grid
            x:Name="TopPanel"
            Grid.Row="0"
            RowDefinitions="Auto,Auto"
            Visibility="Visible">
            <Grid Grid.Row="0">
                <TextBlock
                    Margin="16,10,16,10"
                    VerticalAlignment="Center"
                    FontSize="28"
                    Text="{x:Bind ViewModel.AppViewModel.PageTitle, Mode=OneWay}" />

            </Grid>

            <!--  全部播放 / 随机播放 / 搜索 / 排序 / 来源：同一行；左侧操作 + 弹性空列(*) + 右侧来源靠右  -->
            <Grid
                Grid.Row="1"
                Margin="16,0,16,10"
                ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.PlayAllCommand, Mode=OneWay}"
                    Style="{StaticResource MenuButtonStyle}"
                        BorderBrush="Transparent"
                        Background="Transparent"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontSize="14" helper:IconGlyph.IconKind="Play" />
                        <TextBlock
                            x:Uid="PlayAll"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.ShufflePlayCommand, Mode=OneWay}"
                     Style="{StaticResource MenuButtonStyle}"
      BorderBrush="Transparent"
      Background="Transparent"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontSize="14" helper:IconGlyph.IconKind="Shuffle" />
                        <TextBlock
                            x:Uid="ShufflePlay"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <!--  高度固定为 35（与同行的 MenuButtonStyle 按钮一致）：否则折叠时高度由搜索图标决定、
                      展开时由输入框决定，点一下搜索按钮整行会抖一下  -->
                <Button Grid.Column="2" 
                    Command="{x:Bind ViewModel.AppViewModel.SearchToggleCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="搜索"
                    Background="Transparent"
                    BorderThickness="0"
                    Height="35"
                    Padding="8,0"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <FontIcon  FontSize="14"  helper:IconGlyph.IconKind="Search" Margin="0,0,4,0" />
                       
                        <AutoSuggestBox 
     x:Name="SearchAutoSuggestBox"
     x:Uid="SearchMusic"
                                 FontSize="12"        Height="30" MinHeight="0" Margin="0"
     Width="{x:Bind ViewModel.AppViewModel.IsSearchExpanded, Mode=OneWay, Converter={StaticResource BoolToDoubleConverter}}"
     Visibility="{x:Bind ViewModel.AppViewModel.IsSearchExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
     VerticalAlignment="Center"
                 Background="{ThemeResource TextControlBackground}"
                 BorderBrush="Transparent" 
     Text="{x:Bind ViewModel.AppViewModel.SearchText, Mode=TwoWay}">
                            <!--  背景不能是纯 Transparent：WinUI bug #9005——背景 Alpha=0 时输入光标（caret）按背景反色
                                  退化成白色，亮色主题下完全看不见。这里改成随主题的“近乎透明”（Alpha=0x0A，
                                  视觉上等同透明但 Alpha≠0），亮色取浅色→光标深色，暗色取深色→光标浅色。
                                  另外默认模板在 PointerOver/Focused 等视觉状态里会重新赋值 TextControlBackground*，
                                  视觉状态优先级高于样式与本地值，所以只能覆盖这些画刷本身  -->
                            <AutoSuggestBox.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.ThemeDictionaries>
                                        <ResourceDictionary x:Key="Light">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="#0AFFFFFF" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0AFFFFFF" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0AFFFFFF" />
                                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0AFFFFFF" />
                                        </ResourceDictionary>
                                        <ResourceDictionary x:Key="Dark">
                                            <SolidColorBrush x:Key="TextControlBackground" Color="#0A000000" />
                                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0A000000" />
                                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0A000000" />
                                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#0A000000" />
                                        </ResourceDictionary>
                                    </ResourceDictionary.ThemeDictionaries>
                                    <!--  内嵌 TextBox 的默认最小高度来自该主题资源，不压下来它会顶到 32 左右；
                                          即便此键在当前 WinUI 版本未生效，按钮高度已固定，也不会影响布局  -->
                                    <x:Double x:Key="TextControlThemeMinHeight">30</x:Double>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                </ResourceDictionary>
                            </AutoSuggestBox.Resources>
                        </AutoSuggestBox>
                    </StackPanel>
                   
                </Button>
               
                <ComboBox Grid.Column="3"
                    x:Name="SortByComboBox"
                    Width="130"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.SortOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.AppViewModel.SelectedSortOption, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:SortOption">
                            <TextBlock FontSize="12" Text="{x:Bind DisplayText, Mode=OneWay}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="4"
                    x:Name="UsbDeviceCombox"
                    x:Uid="USBDevice"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    FontSize="12"
                    ItemsSource="{x:Bind ViewModel.UsbDeviceService.Devices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.UsbDeviceService.SelectedDevice, Mode=TwoWay}"
                    Visibility="{x:Bind ViewModel.UsbDeviceService.DevicesVisibility, Mode=OneWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="model:UsbStorageDevice">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{x:Bind Path}" />
                                <TextBlock Text="{x:Bind FreeSpaceInGB}" />
                                <TextBlock Text=" GB" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="5"
                    Width="130"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    DisplayMemberPath="Name"
                    FontSize="12"
                    ItemsSource="{x:Bind ViewModel.RemoteSources.Choices}"
                    SelectedItem="{x:Bind ViewModel.RemoteSources.SelectedSource, Mode=TwoWay}" />
            </Grid>
        </Grid>
        <InfoBar
            x:Name="InfoBar"
            Title="{x:Bind ViewModel.AppViewModel.InfoBarTitle, Mode=OneWay}"
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.AppViewModel.InfoBarIsOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.AppViewModel.InfoBarMessage, Mode=OneWay}"
            Severity="Informational" />
        <Grid Grid.Row="2">
            <Frame
                x:Name="ContentFrame"
                Margin="6,6,0,0"
                IsNavigationStackEnabled="False"
                Visibility="{x:Bind local:MusicBrowsePage.InvertVisibility(ViewModel.AppViewModel.LibraryEmptyVisibility), Mode=OneWay}" />

            <!--  空音乐库占位：整个库无任何歌曲时覆盖内容区，顶栏标签保留  -->
            <Grid
                x:Name="EmptyLibraryGrid"
                AllowDrop="True"
                Background="Transparent"
                DragLeave="EmptyLibraryGrid_DragLeave"
                DragOver="EmptyLibraryGrid_DragOver"
                Drop="EmptyLibraryGrid_Drop"
                Unloaded="EmptyLibraryGrid_Unloaded"
                Visibility="{x:Bind ViewModel.AppViewModel.LibraryEmptyVisibility, Mode=OneWay}">
                <StackPanel
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <Border
                        Width="96"
                        Height="96"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="28">
                        <FontIcon
                            FontSize="44"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            helper:IconGlyph.IconKind="NowPlaying" />
                    </Border>
                    <TextBlock
                        x:Uid="MusicBrowseEmptyTitle"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Uid="MusicBrowseEmptySubtitle"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Margin="0,32,0,0"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.EmptyAddFolderCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <FontIcon helper:IconGlyph.IconKind="SourceLocal" />
                            <TextBlock
                                x:Uid="AddFolder"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        Opacity="0.6"
                        Orientation="Horizontal">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            helper:IconGlyph.IconKind="SourceLocal" />
                        <TextBlock
                            x:Uid="AddFolderPageDragHint"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <!--  拖放反馈层（置于最上层，不拦截拖放事件）  -->
                <Grid
                    x:Name="DropOverlay"
                    Margin="12"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Border
                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                        CornerRadius="12"
                        Opacity="0.35" />
                    <Rectangle
                        Margin="2"
                        RadiusX="10"
                        RadiusY="10"
                        Stroke="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        StrokeDashArray="4,4"
                        StrokeThickness="2" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            helper:IconGlyph.IconKind="SourceLocal" />
                        <TextBlock
                            x:Uid="AddFolderPageDropOverlayText"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
