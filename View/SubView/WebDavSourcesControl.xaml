<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.SubView.WebDavSourcesControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns:vm="using:WinUIMusicPlayer.ViewModel">

    <!--  WebDAV 来源卡片：容器、分组标题与行布局与本地文件夹卡片保持一致；
          标题行的“+”用于新建网络来源。  -->
    <Border Style="{StaticResource LibraryCardStyle}">
        <StackPanel>
            <Grid
                Margin="14,8,14,6"
                ColumnDefinitions="Auto,Auto,*,Auto"
                ColumnSpacing="8">
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource LibraryGroupTitleStyle}"
                    Text="WebDAV" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Sources.Count, Mode=OneWay}"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('WebDavAddSource')}"
                    Click="Add_Click"
                    Style="{StaticResource LibraryCardActionButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('WebDavAddSource')}">
                    <FontIcon FontSize="16" helper:IconGlyph.IconKind="Add" />
                </Button>
            </Grid>

            <Border
                Padding="14,2,14,8"
                Visibility="{x:Bind tools:BindUtils.NonEmptyTextVisibility(ViewModel.Status), Mode=OneWay}">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>

            <!--  空态  -->
            <StackPanel
                Margin="14,4,14,14"
                Orientation="Horizontal"
                Spacing="12"
                Visibility="{x:Bind tools:BindUtils.EmptyCollectionVisibility(ViewModel.Sources.Count), Mode=OneWay}">
                <Border
                    Width="44"
                    Height="44"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="12">
                    <FontIcon
                        FontSize="20"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        helper:IconGlyph.IconKind="SourceRemote" />
                </Border>
                <TextBlock
                    x:Uid="WebDavSourcesEmpty"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Sources, Mode=OneWay}"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WebDavSourceItem">
                        <Grid
                            MinHeight="56"
                            Padding="14,10"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12">
                            <Button
                                Width="40"
                                Height="40"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('WebDavBrowseAction')}"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="Browse_Click"
                                CornerRadius="10"
                                Style="{StaticResource MenuButtonStyle}"
                                Tag="{x:Bind}"
                                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('WebDavBrowseAction')}">
                                <FontIcon
                                    FontSize="18"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    helper:IconGlyph.IconKind="SourceRemote" />
                            </Button>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Address}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind Status, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <StackPanel
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind SongCount, Mode=OneWay}" />
                                    <TextBlock
                                        x:Uid="FolderNumberOfSongs"
                                        Margin="3,0,0,0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button
                                    AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('WebDavScanAction')}"
                                    Command="{x:Bind ScanCommand}"
                                    Style="{StaticResource LibraryCardActionButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('WebDavScanAction')}">
                                    <FontIcon FontSize="16" helper:IconGlyph.IconKind="Import" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('WebDavMoreAction')}"
                                    Style="{StaticResource LibraryCardActionButtonStyle}">
                                    <FontIcon FontSize="16" helper:IconGlyph.IconKind="More" />
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem x:Uid="WebDavPauseMenu" Command="{x:Bind PauseCommand}" />
                                            <MenuFlyoutItem
                                                x:Uid="WebDavEditMenu"
                                                Click="Edit_Click"
                                                Tag="{x:Bind}" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem x:Uid="WebDavRemoveMenu" Command="{x:Bind RemoveCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
