<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WinUIMusicPlayer.View.PlayListPage"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:controls="using:WinUIMusicPlayer.View.Controls"
    xmlns:converters="using:WinUIMusicPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:WinUIMusicPlayer.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:WinUIMusicPlayer.Model"
    xmlns:tool="using:WinUIMusicPlayer.Utils"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="EmptyGrid" Visibility="Collapsed">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Width="96"
                    Height="96"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="28">
                    <FontIcon
                        FontSize="44"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        helper:IconGlyph.IconKind="Music" />
                </Border>
                <TextBlock
                    x:Uid="PlayListPageEmptyTitle"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <TextBlock
                    x:Uid="PlayListPageEmptySubtitle"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="EmptyAddPlayListButton"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Click="AddPlayList_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon helper:IconGlyph.IconKind="GlyphE710" />
                        <TextBlock
                            x:Uid="AddPlayList"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            x:Name="PlayListGrid"
                    IsHitTestVisible="{x:Bind tools:BindUtils.BoolToBoolReConverter(ViewModel.IsInDetailMode), Mode=OneWay}"
                    Opacity="{x:Bind tools:BindUtils.BoolToOpacityReConverter(ViewModel.IsInDetailMode), Mode=OneWay}"
            RowDefinitions="Auto,*">
            <Grid
                Grid.Row="0"
                Margin="16,10,16,10"
                ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="PlaylistTitle"
                        VerticalAlignment="Center"
                        FontSize="28" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.AppViewModel.AllPlayList.Count, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="PlayListPageCountSuffix"
                            Margin="4,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button
                    x:Name="AddPlayListButton"
                    Grid.Column="2"
                    Margin="0"
                    VerticalAlignment="Center"
                    Click="AddPlayList_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            Margin="0,2,0,0"
                            VerticalAlignment="Center"
                            helper:IconGlyph.IconKind="PlayAll" />
                        <TextBlock x:Uid="AddPlayList" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="10,0,10,0">
                <GridView
                    x:Name="PlayListGridView"
                    Margin="6,6,0,0"
                    IsItemClickEnabled="True"
                    ItemClick="PlayListGridView_ItemClick"
                    ItemsSource="{x:Bind ViewModel.AppViewModel.AllPlayList, Mode=OneWay}"
                    RightTapped="PlayListGridView_RightTapped"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:PlayList">
                            <controls:PlayListGridCardControl PlayList="{x:Bind}" />
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
        <controls:PlaylistDetailControl
            x:Name="DetailView"
            Margin="0,20,0,10"
            x:FieldModifier="public"
            IsHitTestVisible="{x:Bind ViewModel.IsInDetailMode, Mode=OneWay}"
                    Opacity="{x:Bind tools:BindUtils.BoolToOpacityConverter(ViewModel.IsInDetailMode), Mode=OneWay}"
            PlaySourceTag="PlayListSongsView" />
    </Grid>
</Page>
