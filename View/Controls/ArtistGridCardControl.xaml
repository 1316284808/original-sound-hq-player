<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="WinUIMusicPlayer.View.Controls.ArtistGridCardControl"
    xmlns:tools="using:WinUIMusicPlayer.Utils"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:WinUIMusicPlayer.Behaviors"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    x:Name="Root">
    <!--  歌手卡片：胶囊外形，左圆形封面（外圈纯色包边遮裁切毛边）+ 播放按钮，右歌手名 / 曲目数。
          配色全部走系统主题画刷：亮色为白卡片 + 黑字，暗色为灰卡片 + 白字。  -->
    <Grid
        Width="280"
        Height="auto"
        Margin="10"
        HorizontalAlignment="Center"
        VerticalAlignment="Center">
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="60">
            <Grid ColumnDefinitions="Auto,*">
                <Border
                    x:Name="CoverBorder"
                    Grid.Column="0"
                    Width="120"
                    Height="120"
                    Margin="0,0,2,0"
                    Padding="0"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    CornerRadius="60">
                    <!--  封面图内缩 10px 并自身裁圆，外圈 10px 纯色包边遮住裁切毛边  -->
                    <Border
                        Width="100"
                        Height="100"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="50">
                        <Image
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Stretch="UniformToFill">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:AlbumCoverBehavior Music="{x:Bind Music, Mode=OneWay}" />
                            </interactivity:Interaction.Behaviors>
                        </Image>
                    </Border>
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBlock
                        MaxWidth="110"
                        Height="60"
                        MaxHeight="80"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        LineHeight="20"
                        Text="{x:Bind Music.Author, Mode=OneWay}"
                        TextAlignment="Left"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap"
                        ToolTipService.ToolTip="{x:Bind Music.Author, Mode=OneWay}" />
                    <Grid Margin="0,8,0,0" ColumnDefinitions="Auto,Auto">
                        <TextBlock
                            Grid.Column="0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind tools:BindUtils.ArtistSongsConverter(Music.Author), Mode=OneWay}"
                            TextAlignment="Left" />
                        <TextBlock
                            x:Uid="AlbumSongs"
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!--  覆盖层：与封面同尺寸，承载播放按钮（居中悬浮在封面上）与设备角标  -->
        <Grid
            Width="120"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Canvas.ZIndex="2">
            <!--  悬浮在封面图上：用次级填充 + 描边的圆形按钮（同播放列表卡片悬停按钮的取色），随主题切换  -->
            <Button
                x:Name="PlayBtn"
                Width="30"
                Height="30"
                MinWidth="0"
                MinHeight="0"
                Margin="0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('IconPlay')}"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Click="PlayArtist_Click"
                CornerRadius="15"
                Tapped="PlayArtist_Tapped"
                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('IconPlay')}">
                <FontIcon
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    helper:IconGlyph.IconKind="Play" />
            </Button>
            <FontIcon
                x:Name="IsExistOnDeviceIcon"
                Margin="0,0,12,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="16"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Glyph="{x:Bind tools:BindUtils.IsExistOnDeviceGlyphConverter(Music.IsExistOnDevice), Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
