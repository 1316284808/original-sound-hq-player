<?xml version="1.0" encoding="utf-8"?>
<winex:WindowEx
    x:Class="WinUIMusicPlayer.DesktopLyrics.DesktopLyricsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:helper="using:WinUIMusicPlayer.Helper"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winex="using:WinUIEx"
    xmlns:tools="using:WinUIMusicPlayer.Utils" 
    mc:Ignorable="d"
    Title="DesktopLyrics">
    <!--  任务栏歌词条带：左歌词 + 右侧控制按钮；整窗点击穿透常开，只有光标移到按钮区才临时取消穿透  -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Height="auto"
        ColumnDefinitions="*,Auto">
        <Grid.Resources>
            <Style TargetType="Button">
                <Setter Property="Width" Value="20" />
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Height" Value="20" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <ContentPresenter
             Margin="2"
            x:Name="RendererHost"
             Background="Transparent"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <StackPanel
            x:Name="ControlPanel"
            Grid.Column="1"
            Margin="8,0,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="4">
            <Button
                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('TaskbarLyricsPrevious')}"
                Command="{x:Bind Playback.PreviousCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('TaskbarLyricsPrevious')}">
                <FontIcon FontSize="10" helper:IconGlyph.IconKind="Previous" />
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind tools:BindUtils.PlayStatusToTextConverter(ViewModel.State.Playback.IsPlaying), Mode=OneWay}"
                Command="{x:Bind Playback.ToggleCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind tools:BindUtils.PlayStatusToTextConverter(ViewModel.State.Playback.IsPlaying), Mode=OneWay}">
                <FontIcon FontSize="10" Glyph="{x:Bind tools:BindUtils.PlayStatusToGlyphConverter(ViewModel.State.Playback.IsPlaying), Mode=OneWay}" />
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('NextSong')}"
                Command="{x:Bind Playback.NextCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('NextSong')}">
                <FontIcon FontSize="10" helper:IconGlyph.IconKind="Next" />
            </Button>
            <Button
                AutomationProperties.Name="{x:Bind tools:ToolUtils.GetString('TaskbarLyricsClose')}"
                Click="CloseButton_Click"
                ToolTipService.ToolTip="{x:Bind tools:ToolUtils.GetString('TaskbarLyricsClose')}">
                <FontIcon FontSize="10" helper:IconGlyph.IconKind="GlyphE711" />
            </Button>
        </StackPanel>
    </Grid>
</winex:WindowEx>
